# Copy to `.env` at the project root. `react-native-config` embeds these in native builds.
# Dev: omit API_URL to use staging by default in __DEV__. Release builds default API to production if unset.
API_URL=https://staging-api.servisca.co.uk
MEDIA_BASE_URL=https://servisca-app.s3.eu-west-2.amazonaws.com
# Public site (used for default Terms / Privacy / FAQ URLs)
SERVISCA_WEB_URL=https://www.servisca.co.uk
# Optional overrides (defaults are derived from SERVISCA_WEB_URL)
# TERMS_URL=https://www.servisca.co.uk/terms
# PRIVACY_URL=https://www.servisca.co.uk/privacy-policy
# FAQ_URL=https://www.servisca.co.uk/help
# SENTRY_DSN=
# Account deletion — align with your backend contract
# USER_DELETE_ACCOUNT_PATH=/user/account
# USER_DELETE_ACCOUNT_METHOD=DELETE
GOOGLE_MAPS_API_KEY=your_api_key_here
# Web client ID (OAuth 2.0) from Firebase Console → Project settings → Your apps → Web SDK config.
# Required for Google Sign-In on iOS; on Android it can be omitted if android/app/google-services.json includes the Web client (client_type 3).
# Rebuild native app after changing .env.
# Android: if you see DEVELOPER_ERROR / "status code 10", add the SHA-1 for your debug keystore in Firebase
# (debug keystore: see android/app/build.gradle), then put the new google-services.json in android/app/.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID_HERE.apps.googleusercontent.com
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Optional: dedicated push registration route. Leave unset if your API only uses device_token on login.
# USER_DEVICE_TOKEN_PATH=/user/device-token
# If the API returns 400, match its JSON keys / device_type strings, e.g.:
# PUSH_DEVICE_TOKEN_FIELD=device_token
# PUSH_DEVICE_TYPE_FIELD=device_type
# DEVICE_TYPE_IOS=ios
# DEVICE_TYPE_ANDROID=android

# Firebase: google-services.json → android/app/; GoogleService-Info.plist → ios/servisca/ (see README).
# iOS: enable Sign in with Apple in Firebase → Authentication → Sign-in method → Apple (use same Apple Developer Team).
